# Xcode project is generated by XcodeGen from project.yml.
# Glob, not `Reps.xcodeproj/` — regenerating with Xcode open leaves a `Reps 2.xcodeproj` behind.
*.xcodeproj/
*.xcworkspace/

# Info.plists and entitlements are generated too — project.yml declares them under
# `info:` and `entitlements:` with the properties inline, so these files are output, not
# source. Committing them would also fight the build bump, which edits project.yml.
# Untracked artifacts are not free: preflight.sh refuses to run on a dirty tree, and
# `git status --porcelain` counts untracked files as dirty.
Reps/Info.plist
Reps/Reps.entitlements
RepsWidget/Info.plist
RepsWidget/RepsWidget.entitlements

# Build products
build/
DerivedData/
.build/
*.ipa
*.dSYM.zip

# Xcode user state
xcuserdata/
*.xcuserstate
*.moved-aside

# SPM
Package.resolved
.swiftpm/

# macOS
.DS_Store

# Python tooling
__pycache__/
*.pyc

# Rendered marketing frames — regenerate with AppStore/marketing/build_frames.py
AppStore/marketing/out/
