# Xcode project is generated by XcodeGen from project.yml.
# Glob, not `Reps.xcodeproj/` — regenerating with Xcode open leaves a `Reps 2.xcodeproj` behind.
*.xcodeproj/
*.xcworkspace/

# Build products
build/
DerivedData/
.build/
*.ipa
*.dSYM.zip

# Xcode user state
xcuserdata/
*.xcuserstate
*.moved-aside

# SPM
Package.resolved
.swiftpm/

# macOS
.DS_Store

# Python tooling
__pycache__/
*.pyc
